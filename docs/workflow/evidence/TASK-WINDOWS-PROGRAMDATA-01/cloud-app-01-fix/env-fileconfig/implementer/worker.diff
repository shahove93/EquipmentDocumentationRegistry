+def legacy_data(tmp_path):
+    source = tmp_path / "legacy"
+    (source / "postgres").mkdir(parents=True)
+    (source / "postgres/PG_VERSION").write_text("18")
+    (source / "attachments").mkdir()
+    (source / "attachments/синтетика.pdf").write_bytes(b"%PDF-legacy")
+    (source / "runtime.json").write_text('{"password":"test","active":"original","revision":"old"}')
+    return source
+
+
+@pytest.mark.parametrize("failure", ["copy", "validate", "stop"])
+def test_failed_legacy_transition_never_publishes_or_changes_source(tmp_path, monkeypatch, failure):
+    from contextlib import contextmanager
+    import app.windows_layout as layout
+    source = legacy_data(tmp_path)
+    target = tmp_path / "state/data"
+    target.parent.mkdir()
+    original = {p.relative_to(source): p.read_bytes() for p in source.rglob("*") if p.is_file()}
+    class FakeRuntime:
+        def __init__(self, stage, install):
+            self.config = {"active": "original"}
+        @contextmanager
+        def database(self):
+            yield
+            if failure == "stop":
+                raise RuntimeError("synthetic stop failure")
+        def validate_pair(self, database):
+            if failure == "validate":
+                raise RuntimeError("synthetic validation failure")
+    monkeypatch.setattr("app.windows_local.Runtime", FakeRuntime)
+    if failure == "copy":
+        monkeypatch.setattr(layout.shutil, "copyfile", lambda *a: (_ for _ in ()).throw(OSError("synthetic copy failure")))
+    with pytest.raises((RuntimeError, OSError), match="synthetic"):
+        layout.migrate_legacy(source, target, tmp_path / "install")
+    assert not target.exists()
+    assert list(target.parent.glob("data.migrate-*"))
+    assert {p.relative_to(source): p.read_bytes() for p in source.rglob("*") if p.is_file()} == original
+
+
+def test_legacy_transition_publishes_only_after_validation_and_stop(tmp_path, monkeypatch):
+    from contextlib import contextmanager
+    from app.windows_layout import migrate_legacy
+    source = legacy_data(tmp_path)
+    target = tmp_path / "state/data"
+    target.parent.mkdir()
+    events = []
+    class FakeRuntime:
+        def __init__(self, stage, install):
+            self.config = {"active": "original"}
+        @contextmanager
+        def database(self):
+            assert not target.exists()
+            yield
+            events.append("stopped")
+        def validate_pair(self, database):
+            assert not target.exists()
+            events.append("validated")
+    monkeypatch.setattr("app.windows_local.Runtime", FakeRuntime)
+    migrate_legacy(source, target, tmp_path / "install")
+    assert events == ["validated", "stopped"]
+    for path in source.rglob("*"):
+        if path.is_file():
+            assert path.read_bytes() == (target / path.relative_to(source)).read_bytes()
+    assert not list(target.parent.glob("data.migrate-*"))
+
