+def test_alembic_env_fileconfig_reads_utf8_chain(tmp_path, monkeypatch):
+    import configparser
+    from contextlib import nullcontext
+    import logging.config
+    from alembic import command
+    from alembic import context as alembic_context
+    from app.windows_local import load_alembic_config
+
+    ini = Path(__file__).resolve().parents[1] / "alembic.ini"
+    cfg = load_alembic_config(ini)
+    monkeypatch.setenv("DATABASE_URL", "postgresql+psycopg://edr:test@127.0.0.1:5432/test")
+    monkeypatch.setenv("STORAGE_ROOT", str(tmp_path / "storage"))
+    original_read = configparser.ConfigParser.read
+
+    def forced_locale_decode(self, filenames, encoding=None):
+        if encoding in (None, "locale"):
+            encoding = "cp1252"
+        return original_read(self, filenames, encoding=encoding)
+
+    monkeypatch.setattr(configparser.ConfigParser, "read", forced_locale_decode)
+
+    # Downstream alembic/env.py logging read without explicit UTF-8 still fails.
+    with pytest.raises(UnicodeDecodeError) as raised:
+        logging.config.fileConfig(cfg.config_file_name)
+    assert raised.value.start == 3635
+    assert raised.value.object[raised.value.start] == 0x81
+
+    # The real offline migrate chain executes the fixed env.py/fileConfig path.
+    monkeypatch.setattr(alembic_context, "configure", lambda *args, **kwargs: None)
+    monkeypatch.setattr(alembic_context, "begin_transaction", nullcontext)
+    monkeypatch.setattr(alembic_context, "run_migrations", lambda *args, **kwargs: None)
+    command.upgrade(cfg, "head", sql=True)
