+def test_installed_layout_checks_intended_sid_and_bom(tmp_path, monkeypatch):
+    import app.windows_layout as layout
+    import app.windows_local as local
+    monkeypatch.setattr(layout, "product_root", lambda install: tmp_path)
+    monkeypatch.setattr(local, "current_sid", lambda: "S-1-5-21-1000")
+    (tmp_path / "owner.json").write_text(json.dumps({"format": 1, "sid": "S-1-5-21-1000", "legacy": str(tmp_path / "old")}), encoding="utf-8-sig")
+    assert layout.installed_layout(tmp_path) == (tmp_path, tmp_path / "old")
+    (tmp_path / "maintenance").touch()
+    with pytest.raises(RuntimeError, match="maintenance"):
+        layout.installed_layout(tmp_path)
+    (tmp_path / "maintenance").unlink()
+    monkeypatch.setattr(local, "current_sid", lambda: "S-1-5-21-2000")
+    with pytest.raises(PermissionError, match="another Windows account"):
+        layout.installed_layout(tmp_path)
