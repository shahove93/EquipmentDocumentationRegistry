+def test_alembic_config_reads_utf8_and_preserves_here(tmp_path):
+    from app.windows_local import load_alembic_config
+    ini = tmp_path / "alembic.ini"
+    ini.write_text(
+        "[alembic]\nscript_location = %(here)s/alembic\n# комментарий UTF-8\n",
+        encoding="utf-8",
+    )
+    cfg = load_alembic_config(ini)
+    location = Path(cfg.get_main_option("script_location"))
+    assert location.resolve() == (tmp_path / "alembic").resolve()
+    assert cfg.config_file_name == str(ini)
