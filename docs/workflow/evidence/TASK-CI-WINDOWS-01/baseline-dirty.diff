+def test_legacy_transition_rejects_links(tmp_path):
+    from app.windows_layout import migrate_legacy
+    source = legacy_data(tmp_path)
+    target = tmp_path / "state/data"
+    target.parent.mkdir()
+    outside = tmp_path / "outside"
+    outside.write_bytes(b"private")
+    (source / "attachments/link").symlink_to(outside)
+    with pytest.raises(ValueError, match="Links/reparse"):
+        migrate_legacy(source, target, tmp_path / "install")
+    assert not target.exists()
+    assert outside.read_bytes() == b"private"
