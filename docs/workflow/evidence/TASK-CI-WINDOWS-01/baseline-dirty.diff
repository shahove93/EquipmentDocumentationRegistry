+def test_legacy_transition_refuses_locked_or_orphan_cluster(tmp_path):
+    from app.windows_layout import migrate_legacy
+    source = legacy_data(tmp_path)
+    target = tmp_path / "state/data"
+    target.parent.mkdir()
+    with exclusive(source):
+        with pytest.raises(Busy):
+            migrate_legacy(source, target, tmp_path / "install")
+    (source / "postgres/postmaster.pid").write_text("123")
+    with pytest.raises(ValueError, match="may be running"):
+        migrate_legacy(source, target, tmp_path / "install")
+    assert not target.exists()
+
