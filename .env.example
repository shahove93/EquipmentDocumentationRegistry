# Шаблон конфигурации Equipment Documentation Registry.
# Скопируйте в .env и подставьте свои значения:
#     cp .env.example .env
# Файл .env игнорируется Git и не должен попадать в репозиторий.

# Обязательный параметр. SQLAlchemy URL PostgreSQL.
# Схема: postgresql+psycopg://<пользователь>:<пароль>@<хост>:<порт>/<имя_базы>
DATABASE_URL=postgresql+psycopg://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:5432/CHANGEME_DATABASE

# Необязательный параметр. Корень локального файлового хранилища документов.
# По умолчанию: storage
STORAGE_ROOT=storage

# Необязательный параметр. Максимальный размер загружаемого файла в байтах.
# По умолчанию: 104857600 (100 МиБ)
MAX_UPLOAD_SIZE_BYTES=104857600